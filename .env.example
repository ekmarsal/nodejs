# ============================================================
# FareHarbor Webhook Server - environment configuration
# Copy to .env for local development. Never commit a real .env.
# ============================================================

# --- Required ------------------------------------------------
# Shared secret configured on the FareHarbor webhook subscription.
# Without it, /webhook returns 503 (fail closed).
FAREHARBOR_WEBHOOK_SECRET=

# Postgres connection string (Railway provides this).
DATABASE_URL=

# Bearer token for /stats and /privacy/*. Minimum 32 characters.
# Generate with: openssl rand -hex 32
ADMIN_API_TOKEN=

# --- Runtime -------------------------------------------------
NODE_ENV=production
PORT=3000

# --- Data protection ----------------------------------------
# Days to retain raw webhook payloads before automatic purge. 0 disables.
EVENT_RETENTION_DAYS=90

# Mask every custom-field answer, not only special-category ones
# (allergies, medical, accessibility, DOB, ID numbers).
REDACT_ALL_CUSTOM_FIELDS=false

# Verify the Postgres server certificate. Requires PGSSLROOTCERT.
DATABASE_SSL_VERIFY=false

# --- Hardening knobs ----------------------------------------
WEBHOOK_BODY_LIMIT=1mb
WEBHOOK_RATE_MAX=300
WEBHOOK_RATE_WINDOW_MS=60000
MAX_SIGNATURE_AGE_SECONDS=300

# Comma-separated browser origins allowed to call this service.
# Leave empty: FareHarbor calls server-to-server and needs no CORS.
ALLOWED_ORIGINS=

# --- Emergency only -----------------------------------------
# Accept unsigned webhooks. Use ONLY during a short migration window
# while the FareHarbor secret is being configured. Leave unset otherwise.
# ALLOW_UNSIGNED_WEBHOOKS=true
